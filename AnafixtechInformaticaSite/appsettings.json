  // Render. Sem ela o site não inicia — é intencional, para não subir apontando para o banco
  // errado.
  // -------------------------------------------------------------------------------------------
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
