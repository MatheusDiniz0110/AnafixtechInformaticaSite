@*
    Layout (moldura) de TODAS as telas da dashboard.
    Ele fica "dentro" do _Layout.cshtml do site: primeiro desenha o cabeçalho e as abas da dashboard,
    depois coloca o conteúdo de cada view no lugar do @RenderBody().
*@
@{
    // Usa o layout principal do site (menu, rodapé) como moldura externa.
    Layout = "_Layout";

    // Aba atual: cada view informa a sua em ViewData["Tab"]; sem informação, assume "Index".
    var abaAtual = ViewData["Tab"]?.ToString() ?? "Index";

    // Quantidade de notificações não lidas, calculada pelo controller (OnActionExecutionAsync).
    var naoLidas = ViewBag.NaoLidas is int n ? n : 0;

    // Lista das abas: (nome da action, texto exibido, ícone).
    var abas = new[]
    {
        (Acao: "Index",        Rotulo: "Visão geral",  Icone: "icone-painel"),
        (Acao: "Pedidos",      Rotulo: "Pedidos (OS)", Icone: "icone-os"),
        (Acao: "Solicitacoes", Rotulo: "Solicitações", Icone: "icone-solicitacao"),
        (Acao: "Agenda",       Rotulo: "Agenda",       Icone: "icone-agenda"),
        (Acao: "Estoque",      Rotulo: "Estoque",      Icone: "icone-estoque"),
        (Acao: "Servicos",     Rotulo: "Serviços",     Icone: "icone-servicos"),
        (Acao: "Financeiro",   Rotulo: "Financeiro",   Icone: "icone-financeiro"),
        (Acao: "Tickets",      Rotulo: "Tickets",      Icone: "icone-ticket"),
        (Acao: "Notificacoes", Rotulo: "Notificações", Icone: "icone-sino")
    };
}

@* Passa o CSS da dashboard para a seção "Head" do _Layout (dentro do <head> da página). *@
@section Head {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

@* Moldura geral da dashboard. *@
<div class="db">

    @* Ícones usados apenas na dashboard. Ficam ocultos e são referenciados por <use>. *@
    <svg class="db-sprite" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <symbol id="icone-painel" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="7" height="7" rx="1" />
            <rect x="14" y="3" width="7" height="7" rx="1" />
            <rect x="3" y="14" width="7" height="7" rx="1" />
            <rect x="14" y="14" width="7" height="7" rx="1" />
        </symbol>
        <symbol id="icone-os" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 3h12v18l-3-2-3 2-3-2-3 2V3Z" />
            <path d="M9 8h6M9 12h6M9 16h4" />
        </symbol>
        <symbol id="icone-solicitacao" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="5" y="4" width="14" height="17" rx="2" />
            <path d="M9 4V2h6v2M9 9h6M9 13h6M9 17h4" />
        </symbol>
        <symbol id="icone-agenda" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="5" width="18" height="16" rx="2" />
            <path d="M8 3v4M16 3v4M3 10h18" />
        </symbol>
        <symbol id="icone-estoque" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="m21 8-9-5-9 5v8l9 5 9-5V8Z" />
            <path d="m3 8 9 5 9-5M12 13v8" />
        </symbol>
        <symbol id="icone-financeiro" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="6" width="20" height="12" rx="2" />
            <circle cx="12" cy="12" r="3" />
            <path d="M6 12h.01M18 12h.01" />
        </symbol>
        <symbol id="icone-servicos" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76Z" />
        </symbol>
        <symbol id="icone-ticket" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 8a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v2a2 2 0 0 0 0 4v2a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-2a2 2 0 0 0 0-4V8Z" />
            <path d="M14 6v12" />
        </symbol>
        <symbol id="icone-sino" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 8a6 6 0 0 0-12 0c0 7-3 8-3 8h18s-3-1-3-8" />
            <path d="M13.7 21a2 2 0 0 1-3.4 0" />
        </symbol>
        <symbol id="icone-alerta" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="m12 3 9 17H3L12 3Z" />
            <path d="M12 9v5M12 17h.01" />
        </symbol>
        <symbol id="icone-info" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="9" />
            <path d="M12 11v5M12 8h.01" />
        </symbol>
    </svg>

    @* Cabeçalho: título à esquerda e sino de notificações à direita. *@
    <div class="db-head">
        <div>
            <h1 class="db-title">Dashboard</h1>
            <div class="db-sub">Painel administrativo — AnaFixTech Informática</div>
        </div>

        @* Sino: leva à aba de notificações e mostra o número de não lidas (se houver). *@
        <a class="db-bell" asp-controller="Dashboard" asp-action="Notificacoes" title="Notificações">
            <svg class="db-icone" aria-hidden="true"><use href="#icone-sino"></use></svg>
            @if (naoLidas > 0)
            {
                <span class="db-bell-count">@(naoLidas > 99 ? "99+" : naoLidas.ToString())</span>
            }
        </a>
    </div>

    @* Barra de abas: uma por seção. A aba atual recebe a classe "active" (destaque azul). *@
    <nav class="db-tabs" aria-label="Seções da dashboard">
        @foreach (var aba in abas)
        {
            <a class="db-tab @(aba.Acao == abaAtual ? "active" : "")" asp-controller="Dashboard" asp-action="@aba.Acao">
                <svg class="db-icone" aria-hidden="true"><use href="#@aba.Icone"></use></svg> @aba.Rotulo
            </a>
        }
    </nav>

    @* Mensagem de sucesso (verde) guardada pelo controller com TempData["Ok"]; aparece uma única vez. *@
    @if (TempData["Ok"] is string mensagemOk)
    {
        <div class="db-alert db-alert--ok" role="status">@mensagemOk</div>
    }

    @* Mensagem de erro (vermelha) guardada pelo controller com TempData["Erro"]. *@
    @if (TempData["Erro"] is string mensagemErro)
    {
        <div class="db-alert db-alert--erro" role="alert">@mensagemErro</div>
    }

    @* Aqui entra o conteúdo específico de cada tela (Index, Pedidos, Financeiro...). *@
    @RenderBody()
</div>

@* Repassa a seção "Scripts" das views (ex.: validação de formulário) para o _Layout principal. *@
@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}
