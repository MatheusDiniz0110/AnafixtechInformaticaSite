@model ErrorViewModel
@{
    ViewData["Title"] = "Página não encontrada";
}

<div class="pagina-erro">
    <span class="rotulo">Erro</span>
    <h1>Não foi possível abrir esta página.</h1>
    <p>
        Isso pode acontecer quando o link está errado ou o endereço mudou.
        Volte para o início ou fale com a AnaFixTech pelo WhatsApp.
    </p>
    @if (Model?.ShowRequestId == true)
    {
        <p class="small text-muted">Código do erro: <code>@Model.RequestId</code></p>
    }
    <div class="d-flex flex-wrap gap-2 mt-4">
        <a class="botao" asp-controller="Home" asp-action="Index">Voltar ao início</a>
        <a class="botao botao--linha" href="https://wa.me/5562998877833" target="_blank" rel="noopener noreferrer">Chamar no WhatsApp</a>
    </div>
</div>
