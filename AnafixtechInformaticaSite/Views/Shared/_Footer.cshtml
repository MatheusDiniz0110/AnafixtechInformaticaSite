@{
    var ano = DateTime.Now.Year;
    var zap = "https://wa.me/5562998877833?text=" + Uri.EscapeDataString("Olá! Preciso de um orçamento para meu equipamento.");
}

<footer class="site-footer" aria-label="Rodapé do site">
    <div class="site-footer__inner">
        <div class="site-footer__marca">
            <a class="site-footer__logo" asp-controller="Home" asp-action="Index">AnaFixTech <span>Informática</span></a>
            <p>
                Conserto e manutenção de computadores, notebooks e periféricos em Anápolis.
                Diagnóstico na bancada, orçamento antes do reparo e garantia de 90 dias no serviço.
            </p>
            <a class="site-footer__zap" href="@zap" target="_blank" rel="noopener noreferrer">
                <svg aria-hidden="true"><use href="#icone-whatsapp"></use></svg>
                Chamar no WhatsApp
            </a>
        </div>

        <nav class="site-footer__col" aria-label="Serviços">
            <h2>Serviços</h2>
            <ul>
                <li><a asp-controller="Services" asp-action="Index" asp-route-categoria="Software">Software e sistema</a></li>
                <li><a asp-controller="Services" asp-action="Index" asp-route-categoria="Hardware">Hardware e limpeza</a></li>
                <li><a asp-controller="Services" asp-action="Index" asp-route-categoria="Dados">Backup e dados</a></li>
                <li><a asp-controller="Services" asp-action="Index">Catálogo completo</a></li>
            </ul>
        </nav>

        <nav class="site-footer__col" aria-label="Atendimento">
            <h2>Atendimento</h2>
            <ul>
                <li><a asp-controller="ServiceRequest" asp-action="Create">Solicitar orçamento</a></li>
                <li><a asp-controller="ServiceRequest" asp-action="Acompanhar">Acompanhar pedido</a></li>
                <li><a asp-controller="Home" asp-action="Forum">Dúvidas frequentes</a></li>
                <li><a asp-controller="Home" asp-action="Sobre">Sobre a AnaFixTech</a></li>
            </ul>
        </nav>

        <address class="site-footer__col site-footer__contato">
            <h2>Contato</h2>
            <ul>
                <li><a href="https://wa.me/5562998877833" target="_blank" rel="noopener noreferrer">(62) 99887-7833</a></li>
                <li><a href="mailto:matheus.diniz.t@outlook.com">matheus.diniz.t@outlook.com</a></li>
                <li><a href="https://www.instagram.com/anafixtech_informatica15" target="_blank" rel="noopener noreferrer">@@anafixtech_informatica15</a></li>
            </ul>

            <p class="site-footer__local">
                Anápolis, Goiás<br />
                @* TODO: preencher com o endereço real da bancada e o horário de atendimento. *@
                Endereço e horário confirmados pelo WhatsApp.
            </p>
        </address>
    </div>

    <div class="site-footer__bottom">
        <div class="site-footer__bottom-inner">
            <p>&copy; @ano AnaFixTech Informática</p>
            <p>
                <a asp-controller="Home" asp-action="Privacy">Política de Privacidade</a>
                <span aria-hidden="true">·</span>
                Site feito por <a href="https://github.com/MatheusDiniz0110" target="_blank" rel="noopener noreferrer">Matheus Diniz Tereza</a>
                <span aria-hidden="true">·</span>
                <a href="#topo">Voltar ao topo</a>
            </p>
        </div>
    </div>
</footer>
