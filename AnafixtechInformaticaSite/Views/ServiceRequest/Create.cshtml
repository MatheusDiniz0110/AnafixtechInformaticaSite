@model ServiceRequestFormViewModel
@{
    ViewData["Title"] = "Solicitar orçamento";
    ViewData["Description"] = "Descreva o problema do seu computador ou notebook e peça um orçamento à AnaFixTech em Anápolis. O valor é confirmado antes do reparo.";
}

@section Head {
    <link rel="stylesheet" href="~/css/serviceRequest.css" asp-append-version="true" />
}

<div class="pedido">
    <header class="pedido__topo">
        <span class="rotulo">Solicitação de serviço</span>
        <h1>Conte o que está acontecendo com o equipamento.</h1>
        <p>
            Preencha os dados abaixo. A AnaFixTech analisa o pedido e entra em contato com o diagnóstico
            e o valor. Você só autoriza o reparo depois de saber o preço.
        </p>
    </header>

    <div class="pedido__grade">
        <div class="pedido__formulario">
            <form asp-controller="ServiceRequest" asp-action="Create" method="post"
                  enctype="multipart/form-data" class="sr-form">

                <div asp-validation-summary="ModelOnly" class="sr-alert"></div>

                @* Campo invisível para pessoas; se vier preenchido, o controller descarta o envio. *@
                <div class="sr-hp" aria-hidden="true">
                    <label asp-for="Website">Não preencha este campo</label>
                    <input asp-for="Website" tabindex="-1" autocomplete="off" />
                </div>

                <h2 class="sr-section">Seus dados</h2>

                <div class="sr-grid">
                    <div class="sr-field">
                        <label asp-for="ContactName"></label>
                        <input asp-for="ContactName" class="sr-input" autocomplete="name" placeholder="Nome de quem vamos atender" />
                        <span asp-validation-for="ContactName" class="sr-error"></span>
                    </div>

                    <div class="sr-field">
                        <label asp-for="ContactPhone"></label>
                        <input asp-for="ContactPhone" class="sr-input" autocomplete="tel" placeholder="(62) 99999-9999" />
                        <span asp-validation-for="ContactPhone" class="sr-error"></span>
                    </div>

                    <div class="sr-field sr-field--full">
                        <label asp-for="ContactEmail"></label>
                        <input asp-for="ContactEmail" class="sr-input" autocomplete="email" placeholder="voce@exemplo.com" />
                        <span asp-validation-for="ContactEmail" class="sr-error"></span>
                    </div>

                    <div class="sr-field sr-field--full">
                        <label asp-for="ContactAddress"></label>
                        <input asp-for="ContactAddress" class="sr-input" autocomplete="street-address" placeholder="Rua, número e bairro, se quiser que a gente busque o equipamento" />
                        <span asp-validation-for="ContactAddress" class="sr-error"></span>
                    </div>
                </div>

                <label class="sr-check">
                    <input asp-for="PickupRequested" />
                    Quero que a AnaFixTech busque o equipamento no meu endereço
                </label>

                <h2 class="sr-section">Equipamento e problema</h2>

                <div class="sr-grid">
                    <div class="sr-field">
                        <label asp-for="Device"></label>
                        <input asp-for="Device" class="sr-input" placeholder="Ex.: Notebook Dell Inspiron 15" />
                        <span asp-validation-for="Device" class="sr-error"></span>
                    </div>

                    <div class="sr-field">
                        <label asp-for="ServiceId"></label>
                        <select asp-for="ServiceId" class="sr-input">
                            <option value="">Não sei / outro serviço</option>
                            @foreach (var servico in Model.Servicos)
                            {
                                <option value="@servico.Id">
                                    @servico.Title@(servico.Price > 0 ? " - " + Fmt.Money(servico.Price) : " - sob consulta")
                                </option>
                            }
                        </select>
                        <span asp-validation-for="ServiceId" class="sr-error"></span>
                    </div>

                    <div class="sr-field sr-field--full">
                        <label asp-for="Description"></label>
                        <textarea asp-for="Description" class="sr-input sr-textarea" rows="6"
                                  placeholder="Ex.: o notebook liga, mas a tela fica preta depois de alguns minutos. Começou na semana passada, depois de uma atualização."></textarea>
                        <span asp-validation-for="Description" class="sr-error"></span>
                    </div>

                    <div class="sr-field sr-field--full">
                        <label asp-for="Photo"></label>
                        <input asp-for="Photo" type="file" class="sr-input sr-file"
                               accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
                        <span class="sr-hint">JPG, PNG ou WEBP, até 5 MB. Serve para adiantar o diagnóstico.</span>
                        <span asp-validation-for="Photo" class="sr-error"></span>
                    </div>
                </div>

                <label class="sr-check sr-check--terms">
                    <input asp-for="AcceptPrivacy" />
                    Autorizo o contato e o uso destes dados para o atendimento da minha solicitação.
                </label>
                <span asp-validation-for="AcceptPrivacy" class="sr-error"></span>

                <button type="submit" class="sr-btn">Enviar solicitação</button>

                <p class="sr-note">
                    Ao enviar, você recebe um protocolo para acompanhar o atendimento.
                    Os dados não são compartilhados com terceiros.
                </p>
            </form>
        </div>

        <aside class="pedido__apoio" aria-labelledby="apoio-titulo">
            <h2 id="apoio-titulo">O que acontece depois</h2>
            <ol>
                <li>Você recebe um protocolo na tela.</li>
                <li>Entramos em contato pelo telefone ou e-mail informado.</li>
                <li>Passamos o diagnóstico e o valor antes de qualquer reparo.</li>
                <li>Com a sua autorização, o serviço é feito e testado.</li>
            </ol>

            <p class="pedido__apoio-nota">
                @* TODO: preencher com o horário real de retorno. *@
                O retorno é feito no horário de atendimento. Se precisar de resposta rápida, chame no WhatsApp.
            </p>

            <a class="botao botao--whats botao--pequeno"
               href="https://wa.me/5562998877833?text=@Uri.EscapeDataString("Olá! Estou preenchendo o formulário de solicitação.")"
               target="_blank" rel="noopener noreferrer">
                <svg aria-hidden="true"><use href="#icone-whatsapp"></use></svg>
                Chamar no WhatsApp
            </a>

            <p class="pedido__apoio-endereco">
                Atendimento em Anápolis, Goiás.<br />
                @* TODO: preencher com endereço e horário reais. *@
                Endereço e horário confirmados pelo WhatsApp.
            </p>
        </aside>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
