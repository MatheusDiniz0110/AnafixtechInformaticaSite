@using AnafixtechInformaticaSite.Services
@model List<AnafixtechInformaticaSite.Models.Service>
@{
    ViewData["Title"] = "Serviços e preços de referência";
    ViewData["Description"] = "Catálogo da AnaFixTech em Anápolis: formatação, limpeza, troca de SSD, memória, backup, recuperação de dados e outros serviços. Veja o que está incluso e o prazo.";

    bool Ativo(Service s)
    {
        var status = (s.Status ?? "").Trim().ToLowerInvariant();
        var inativos = new[] { "inativo", "inactive", "indisponivel", "indisponível", "desativado", "oculto" };
        return !inativos.Contains(status);
    }

    var servicos = Model.Where(Ativo).OrderBy(s => s.Class).ThenBy(s => s.Title).ToList();
    var categorias = servicos.Select(s => s.Class).Distinct().OrderBy(c => c).ToList();

    string LinkWhatsApp(Service s)
    {
        var texto = $"Olá! Quero um orçamento para o serviço: {s.Title}.";
        return "https://wa.me/5562998877833?text=" + Uri.EscapeDataString(texto);
    }
}

@section Head {
    <link rel="stylesheet" href="~/css/services.css" asp-append-version="true" />
}

<div class="catalogo">
    <header class="catalogo__topo">
        <span class="rotulo">Catálogo</span>
        <h1>Serviços e preços de referência</h1>
        <p>
            São 26 serviços de software, hardware e dados. O valor ao lado é uma referência:
            o preço final sai depois do diagnóstico e você autoriza antes de qualquer reparo.
        </p>
    </header>

    @if (!servicos.Any())
    {
        <p class="catalogo__vazio">Nenhum serviço está publicado no momento. Fale pelo WhatsApp para consultar o atendimento.</p>
    }
    else
    {
        <div class="catalogo__ferramentas">
            <div class="catalogo__busca">
                <label for="busca-servicos">Buscar no catálogo</label>
                <input id="busca-servicos" type="search" placeholder="Ex.: formatação, SSD, backup, teclado" autocomplete="off" />
            </div>

            <div class="catalogo__filtros" id="filtro-tabs" role="group" aria-label="Filtrar por categoria">
                <button type="button" class="filtro ativo" data-filtro="Todos" aria-pressed="true">
                    Todos <span>@servicos.Count</span>
                </button>
                @foreach (var categoria in categorias)
                {
                    <button type="button" class="filtro" data-filtro="@categoria" aria-pressed="false">
                        @categoria <span>@servicos.Count(s => s.Class == categoria)</span>
                    </button>
                }
            </div>
        </div>

        <p class="catalogo__resultado" id="resultado-servicos" aria-live="polite">@servicos.Count serviços</p>

        <div class="catalogo__lista" id="lista-servicos">
            @foreach (var categoria in categorias)
            {
                var itens = servicos.Where(s => s.Class == categoria).ToList();
                <section class="categoria-servico" data-grupo>
                    <header class="categoria-servico__topo">
                        <h2>@categoria</h2>
                        <span>@itens.Count @(itens.Count == 1 ? "serviço" : "serviços")</span>
                    </header>

                    @foreach (var servico in itens)
                    {
                        var detalhe = ServiceCatalogCopy.Obter(servico.Title);

                        <article class="servico"
                                 data-categoria="@servico.Class"
                                 data-busca="@((servico.Title + " " + servico.Description + " " + servico.Class + " " + detalhe.Inclui).ToLowerInvariant())">
                            <div class="servico__resumo">
                                <div class="servico__texto">
                                    <h3>@servico.Title</h3>
                                    <p>@servico.Description</p>
                                </div>
                                <p class="servico__preco">
                                    @(servico.Price > 0 ? Fmt.Money(servico.Price) : "Sob consulta")
                                </p>
                            </div>

                            <details class="servico__detalhe">
                                <summary>O que está incluso e prazo</summary>
                                <div class="servico__detalhe-corpo">
                                    <p>@detalhe.Inclui</p>
                                    <p class="servico__prazo"><strong>Prazo:</strong> @detalhe.Prazo</p>
                                    <div class="servico__acoes">
                                        <a class="botao botao--pequeno"
                                           asp-controller="ServiceRequest" asp-action="Create" asp-route-serviceId="@servico.Id">
                                            Pedir orçamento
                                        </a>
                                        <a class="link-whats" href="@LinkWhatsApp(servico)" target="_blank" rel="noopener noreferrer">
                                            <svg aria-hidden="true"><use href="#icone-whatsapp"></use></svg>
                                            Chamar no WhatsApp
                                        </a>
                                    </div>
                                </div>
                            </details>
                        </article>
                    }
                </section>
            }
        </div>

        <p class="catalogo__vazio" id="sem-resultados" hidden>
            Nenhum serviço encontrado com esse termo. Tente outra palavra ou selecione "Todos".
        </p>
    }

    <aside class="catalogo__aviso">
        <h2>Como o orçamento é feito</h2>
        <p>
            O valor do catálogo serve para você ter uma ideia. No diagnóstico, verificamos o estado do equipamento
            e informamos o preço final antes de começar. Se a peça necessária não estiver disponível, avisamos o prazo.
        </p>
        <a class="botao botao--linha botao--pequeno" asp-controller="ServiceRequest" asp-action="Create">Descrever meu problema</a>
    </aside>
</div>

@section Scripts {
    <script src="~/js/catalogo-servicos.js" asp-append-version="true"></script>
}
