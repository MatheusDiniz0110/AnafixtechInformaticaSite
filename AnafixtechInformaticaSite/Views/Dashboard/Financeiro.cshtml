@* Aba "Financeiro": resumo do período e lista de lançamentos. Recebe um FinanceiroViewModel. *@
@model FinanceiroViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Financeiro";
    ViewData["Tab"] = "Financeiro";

    // Datas do filtro no formato que o <input type="date"> exige (aaaa-mm-dd).
    var deIso = Model.De.ToString("yyyy-MM-dd");
    var ateIso = Model.Ate.ToString("yyyy-MM-dd");
}

@* Cabeçalho com os botões de novo lançamento (a tela já abre com o tipo escolhido). *@
<div class="db-card-head">
    <h2>Financeiro</h2>
    <div class="db-inline">
        <a class="db-btn db-btn--primary" asp-controller="Dashboard" asp-action="LancamentoNovo" asp-route-tipo="Entrada">+ Entrada</a>
        <a class="db-btn" asp-controller="Dashboard" asp-action="LancamentoNovo" asp-route-tipo="Saida">+ Saída</a>
    </div>
</div>

@* ===== Banner "Aguardando OK": pendentes NÃO somam nos totais; lote exige confirmação ===== *@
@if (Model.SugestoesPendentes.Any())
{
    var totalPendente = Model.SugestoesPendentes.Sum(s => s.Valor);

    <form method="post" asp-controller="Dashboard" asp-action="SugestoesAprovarLote"
          id="form-lote" class="db-card db-mb" data-confirmar="true">
        <div class="db-card-head">
            <h2>Aguardando OK <span class="db-badge db-badge--amber">@Model.SugestoesPendentes.Count</span></h2>
            <span class="db-muted">@Fmt.Money(totalPendente) em sugestões (fora dos totais)</span>
        </div>

        <div class="db-table-wrap">
            <table class="db-table db-table--compact">
                <thead>
                    <tr><th></th><th>OS</th><th>Data sugerida</th><th>Forma</th><th>Sócio</th><th class="db-num">Valor sugerido</th></tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.SugestoesPendentes)
                    {
                        <tr>
                            <td>
                                <label class="db-check">
                                    @* id e token viajam juntos: um formulário antigo não decide uma sugestão mudada. *@
                                    <input type="checkbox" name="Selecionadas" value="@(s.Id)|@(s.Token)"
                                           data-valor="@s.Valor.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" />
                                    <span class="db-muted">Selecionar</span>
                                </label>
                            </td>
                            <td><a asp-controller="Dashboard" asp-action="PedidoDetalhes" asp-route-id="@s.ServiceOrderId">@(s.ServiceOrder?.Codigo ?? $"OS-{s.ServiceOrderId:D5}")</a></td>
                            <td>@Fmt.Date(s.DataSugerida)</td>
                            <td>@s.FormaPagamentoSugerida.ToLabel()</td>
                            <td>@s.SocioSugerido</td>
                            <td class="db-num db-pos">@Fmt.Money(s.Valor)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="db-form db-mt">
            <div class="db-field">
                <label>Data para o lote (opcional)</label>
                <input type="date" name="Data" class="db-input" />
            </div>
            <div class="db-field">
                <label>Forma de pagamento (opcional)</label>
                <select name="FormaPagamento" class="db-select">
                    <option value="">Manter a sugerida</option>
                    @foreach (var forma in Enum.GetValues<PaymentMethod>())
                    {
                        <option value="@forma">@forma.ToLabel()</option>
                    }
                </select>
            </div>
            <div class="db-field db-field--full">
                <label>Observação comum (opcional)</label>
                <input type="text" name="Observacao" maxlength="400" class="db-input" />
            </div>
        </div>

        <div class="db-inline db-mt">
            <input type="hidden" name="AprovarTodas" id="aprovar-todas" value="false" />
            <button type="submit" class="db-btn db-btn--primary" data-lote="selecionadas">Aprovar selecionadas</button>
            <button type="submit" class="db-btn" data-lote="todas">Aprovar todas</button>
            <span class="db-muted">Valores e sócios continuam individuais. Nada é gravado antes da confirmação.</span>
        </div>
    </form>

    @* Confirmação: mostra quantidade e total; só o clique em Confirmar faz o POST. *@
    <div id="modal-lote" class="db-modal" role="dialog" aria-modal="true" aria-labelledby="modal-lote-titulo" hidden>
        <div class="db-modal-box db-card">
            <h2 id="modal-lote-titulo">Confirmar aprovação em lote</h2>
            <p id="modal-lote-resumo" class="db-modal-resumo"></p>
            <p class="db-muted">Nenhum lançamento existe até você confirmar. Depois da confirmação, cada OS é recalculada a partir das entradas gravadas.</p>
            <div class="db-inline">
                <button type="button" class="db-btn" id="modal-lote-cancelar">Cancelar</button>
                <button type="button" class="db-btn db-btn--primary" id="modal-lote-confirmar">Confirmar aprovação</button>
            </div>
        </div>
    </div>

    <script>
        (function () {
            var form = document.getElementById('form-lote');
            var modal = document.getElementById('modal-lote');
            if (!form || !modal) return;

            var resumo = document.getElementById('modal-lote-resumo');
            var confirmar = document.getElementById('modal-lote-confirmar');
            var cancelar = document.getElementById('modal-lote-cancelar');
            var todasFlag = document.getElementById('aprovar-todas');
            var moeda = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' });
            var pendente = null;

            form.addEventListener('submit', function (event) {
                if (form.dataset.confirmar !== 'true') return;
                event.preventDefault();

                var todas = !!event.submitter && event.submitter.dataset.lote === 'todas';
                var caixas = Array.from(form.querySelectorAll('input[name="Selecionadas"]'));
                var itens = todas ? caixas : caixas.filter(function (c) { return c.checked; });

                if (itens.length === 0) {
                    window.alert('Selecione ao menos uma sugestão.');
                    return;
                }

                var total = itens.reduce(function (soma, caixa) {
                    return soma + (parseFloat(caixa.dataset.valor) || 0);
                }, 0);
                resumo.textContent = 'Você vai aprovar ' + itens.length + ' sugestão(ões), totalizando '
                    + moeda.format(total) + '.';
                pendente = { todas: todas };
                modal.hidden = false;
            });

            cancelar.addEventListener('click', function () {
                pendente = null;
                modal.hidden = true;
            });

            confirmar.addEventListener('click', function () {
                if (!pendente) return;
                // Desarma o submit e os botões: um duplo clique não pode gerar outro POST.
                form.dataset.confirmar = 'false';
                confirmar.disabled = true;
                cancelar.disabled = true;
                todasFlag.value = pendente.todas ? 'true' : 'false';
                form.submit();
            });
        })();
    </script>
}

@* Filtros: período, tipo e sócio (método GET: ficam no endereço). *@
<form method="get" asp-controller="Dashboard" asp-action="Financeiro" class="db-form db-mb">
    <div class="db-field"><label>De</label><input type="date" name="de" value="@deIso" class="db-input" /></div>
    <div class="db-field"><label>Até</label><input type="date" name="ate" value="@ateIso" class="db-input" /></div>
    <div class="db-field">
        <label>Tipo</label>
        <select name="tipo" class="db-select">
            <option value="">Todos</option>
            @foreach (var t in Enum.GetValues<EntryType>())
            {
                <option value="@t" selected="@(Model.Tipo == t)">@t.ToLabel()</option>
            }
        </select>
    </div>
    <div class="db-field">
        <label>Sócio</label>
        <select name="socio" class="db-select">
            <option value="">Todos</option>
            @foreach (var s in DashboardLists.Socios)
            {
                <option value="@s" selected="@(Model.Socio == s)">@s</option>
            }
        </select>
    </div>
    <div class="db-field"><button type="submit" class="db-btn">Filtrar</button></div>
</form>

@* Indicadores do período filtrado. *@
<div class="db-grid db-grid--4">
    <div class="db-kpi"><div class="db-kpi-label">Entradas</div><div class="db-kpi-value db-pos">@Fmt.Money(Model.Entradas)</div></div>
    <div class="db-kpi"><div class="db-kpi-label">Saídas</div><div class="db-kpi-value db-neg">@Fmt.Money(Model.Saidas)</div></div>
    <div class="db-kpi"><div class="db-kpi-label">Saldo</div><div class="db-kpi-value @(Model.Saldo < 0 ? "db-neg" : "")">@Fmt.Money(Model.Saldo)</div></div>
</div>

@* Resumos lado a lado: por categoria e por sócio. *@
<div class="db-grid db-grid--2">
    <div class="db-card">
        <h2>Por categoria</h2>
        @if (!Model.PorCategoria.Any())
        {
            <div class="db-empty">Sem lançamentos no período.</div>
        }
        else
        {
            <ul class="db-list">
                @foreach (var c in Model.PorCategoria)
                {
                    <li>
                        <span>@c.Categoria <span class="db-muted">(@c.Tipo.ToLabel())</span></span>
                        <strong class="@(c.Tipo == EntryType.Entrada ? "db-pos" : "db-neg")">@Fmt.Money(c.Total)</strong>
                    </li>
                }
            </ul>
        }
    </div>

    <div class="db-card">
        <h2>Por sócio</h2>
        @if (!Model.PorSocio.Any())
        {
            <div class="db-empty">Sem lançamentos no período.</div>
        }
        else
        {
            <div class="db-table-wrap">
                <table class="db-table db-table--compact">
                    <thead><tr><th>Sócio</th><th class="db-num">Entradas</th><th class="db-num">Saídas</th></tr></thead>
                    <tbody>
                        @foreach (var s in Model.PorSocio)
                        {
                            <tr>
                                <td>@s.Socio</td>
                                <td class="db-num db-pos">@Fmt.Money(s.Entradas)</td>
                                <td class="db-num db-neg">@Fmt.Money(s.Saidas)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@* Aviso se havia mais linhas do que o limite exibido. *@
@if (Model.Cortado)
{
    <div class="db-alert db-alert--erro">Mostrando apenas os lançamentos mais recentes. Reduza o período para ver os demais.</div>
}

@* Tabela de lançamentos. *@
<div class="db-table-wrap">
    <table class="db-table">
        <thead>
            <tr><th>Data</th><th>Descrição</th><th>Categoria</th><th>Sócio</th><th>Forma</th><th>Origem</th><th class="db-num">Valor</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var l in Model.Lancamentos)
            {
                <tr>
                    <td>@Fmt.Date(l.Data)</td>
                    <td>
                        @l.Descricao
                        @* Se o lançamento veio de uma OS, mostra o link para ela. *@
                        @if (l.ServiceOrder != null)
                        {
                            <a asp-controller="Dashboard" asp-action="PedidoDetalhes" asp-route-id="@l.ServiceOrderId">(@l.ServiceOrder.Codigo)</a>
                        }
                    </td>
                    <td>@l.Categoria</td>
                    <td>@l.Socio</td>
                    <td>@l.FormaPagamento.ToLabel()</td>
                    <td><span class="db-badge db-badge--gray">@l.Origem.ToLabel()</span></td>
                    <td class="db-num"><strong class="@(l.Tipo == EntryType.Entrada ? "db-pos" : "db-neg")">@(l.Tipo == EntryType.Entrada ? "+" : "−") @Fmt.Money(l.Valor)</strong></td>
                    <td class="db-num">
                        @* Editar abre o formulário já preenchido; excluir pede confirmação. *@
                        <div class="db-inline">
                            <a class="db-btn db-btn--sm" asp-controller="Dashboard" asp-action="LancamentoEditar" asp-route-id="@l.Id">Editar</a>
                            <form asp-controller="Dashboard" asp-action="LancamentoExcluir" method="post" class="db-inline" onsubmit="return confirm('Excluir este lançamento?');">
                                <input type="hidden" name="id" value="@l.Id" />
                                <button type="submit" class="db-btn db-btn--danger db-btn--sm">Excluir</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            @if (!Model.Lancamentos.Any())
            {
                <tr><td colspan="8" class="db-empty">Nenhum lançamento no período.</td></tr>
            }
        </tbody>
    </table>
</div>
