@{
    ViewData["Title"] = "Assistência técnica de computador e notebook em Anápolis";
    ViewData["Description"] = "Conserto de computador e notebook em Anápolis (GO). Diagnóstico na bancada, orçamento antes do reparo, backup e recuperação de dados. Garantia de 90 dias no serviço.";

    var zap = "https://wa.me/5562998877833?text=" + Uri.EscapeDataString("Olá! Preciso de um orçamento para meu equipamento.");

    var urlSite = $"{Context.Request.Scheme}://{Context.Request.Host}";
    var dadosEstruturados = new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "LocalBusiness",
        ["name"] = "AnaFixTech Informática",
        ["description"] = "Assistência técnica de computadores e notebooks em Anápolis (GO): manutenção, formatação, backup, recuperação de dados e suporte.",
        ["url"] = urlSite,
        ["telephone"] = "+5562998877833",
        ["email"] = "matheus.diniz.t@outlook.com",
        ["image"] = urlSite + "/images/og-anafixtech.png",
        ["address"] = new Dictionary<string, object?>
        {
            ["@type"] = "PostalAddress",
            ["addressLocality"] = "Anápolis",
            ["addressRegion"] = "GO",
            ["addressCountry"] = "BR"
        },
        ["areaServed"] = "Anápolis e região",
        ["sameAs"] = new[] { "https://www.instagram.com/anafixtech_informatica15" }
    };
}

@section Head {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <script type="application/ld+json">
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(dadosEstruturados))
    </script>
}

<section class="abertura">
    <div class="abertura__texto">
        <span class="rotulo">Conserto e manutenção em Anápolis</span>
        <h1>Computador e notebook:<br />diagnóstico antes do orçamento.</h1>
        <p class="abertura__lead">
            A AnaFixTech faz manutenção de computadores, instalação de sistemas, backup e recuperação de dados.
            O equipamento é avaliado na bancada e você recebe o valor antes de qualquer reparo começar.
        </p>
        <div class="abertura__acoes">
            <a class="botao botao--whats" href="@zap" target="_blank" rel="noopener noreferrer">
                <svg aria-hidden="true"><use href="#icone-whatsapp"></use></svg>
                Chamar no WhatsApp
            </a>
            <a class="botao botao--linha" asp-controller="ServiceRequest" asp-action="Create">
                Solicitar orçamento
            </a>
        </div>
        <p class="abertura__nota">
            Atendimento em Anápolis. A busca e a entrega do equipamento são combinadas pelo WhatsApp.
        </p>
    </div>

    <aside class="ficha" aria-labelledby="ficha-titulo">
        <span class="ficha__numero">Antes de trazer</span>
        <h2 id="ficha-titulo">O que ajuda no atendimento</h2>
        <ul>
            <li>Faça backup dos arquivos que não podem ser perdidos. Se não conseguir, avise no contato.</li>
            <li>Traga o carregador. Em notebook, traga também a senha de acesso.</li>
            <li>Anote quando o problema começou e o que aparece na tela.</li>
            <li>Se puder, envie uma foto do equipamento pelo formulário.</li>
        </ul>
        <a class="ficha__link" asp-controller="ServiceRequest" asp-action="Create">
            Abrir solicitação
            <svg aria-hidden="true"><use href="#icone-seta"></use></svg>
        </a>
    </aside>
</section>

<section class="secao" id="servicos">
    <div class="secao__cabecalho">
        <div>
            <span class="rotulo">Serviços</span>
            <h2 class="titulo-secao">O que a bancada resolve</h2>
        </div>
        <p>
            O catálogo tem 26 serviços, com valor de referência e a descrição do que está incluso.
            O valor final depende do diagnóstico.
        </p>
    </div>

    <div class="grupos">
        <article class="grupo">
            <span class="grupo__numero">01</span>
            <div class="grupo__corpo">
                <h3>Software e sistema</h3>
                <p>Formatação e instalação do Windows ou Linux, Office, antivírus, drivers, correção de erros de inicialização e otimização.</p>
            </div>
            <a class="grupo__link" asp-controller="Services" asp-action="Index" asp-route-categoria="Software">
                Ver serviços
                <svg aria-hidden="true"><use href="#icone-seta"></use></svg>
            </a>
        </article>

        <article class="grupo">
            <span class="grupo__numero">02</span>
            <div class="grupo__corpo">
                <h3>Hardware e limpeza</h3>
                <p>Limpeza interna, troca de pasta térmica, SSD, memória, fonte, cooler, teclado, tela e montagem de computador.</p>
            </div>
            <a class="grupo__link" asp-controller="Services" asp-action="Index" asp-route-categoria="Hardware">
                Ver serviços
                <svg aria-hidden="true"><use href="#icone-seta"></use></svg>
            </a>
        </article>

        <article class="grupo">
            <span class="grupo__numero">03</span>
            <div class="grupo__corpo">
                <h3>Backup e dados</h3>
                <p>Backup de arquivos pessoais, rotina automática, clonagem de HD para SSD, migração do sistema e recuperação de arquivos apagados.</p>
            </div>
            <a class="grupo__link" asp-controller="Services" asp-action="Index" asp-route-categoria="Dados">
                Ver serviços
                <svg aria-hidden="true"><use href="#icone-seta"></use></svg>
            </a>
        </article>
    </div>

    <p class="secao__rodape">
        Os preços do catálogo são referência. Nenhum reparo começa sem a sua autorização.
        <a asp-controller="Services" asp-action="Index">Abrir o catálogo completo</a>.
    </p>
</section>

<section class="secao secao--como" id="como-funciona">
    <div class="secao__lateral">
        <span class="rotulo">Atendimento</span>
        <h2 class="titulo-secao">Como funciona</h2>
        <p>
            A maior parte dos serviços fica pronta entre 24 e 96 horas.
            Quando é preciso esperar por uma peça, o prazo é informado antes de continuar.
        </p>
        <a class="botao botao--linha botao--pequeno" asp-controller="ServiceRequest" asp-action="Create">Abrir solicitação</a>
    </div>

    <ol class="passos">
        <li>
            <strong>Você descreve o problema</strong>
            <span>Preencha o formulário ou mande uma mensagem no WhatsApp. Se puder, envie uma foto da tela ou do equipamento.</span>
        </li>
        <li>
            <strong>Diagnóstico e orçamento</strong>
            <span>Avaliamos o equipamento e enviamos o valor. Nada é feito sem a sua autorização.</span>
        </li>
        <li>
            <strong>Reparo e teste</strong>
            <span>Executamos o serviço e testamos o equipamento. Se houver peça envolvida, avisamos o prazo.</span>
        </li>
        <li>
            <strong>Retirada e garantia</strong>
            <span>Você retira na bancada ou combinamos a entrega. O serviço tem 90 dias de garantia.</span>
        </li>
    </ol>
</section>

<section class="secao" id="atendimento">
    <div class="secao__cabecalho">
        <div>
            <span class="rotulo">Onde e quando</span>
            <h2 class="titulo-secao">Atendimento em Anápolis</h2>
        </div>
        <p>
            O atendimento é feito na bancada e também com busca do equipamento na cidade.
            Confirme o endereço e o horário antes de sair de casa.
        </p>
    </div>

    <div class="dados-atendimento">
        <div>
            <h3><svg aria-hidden="true"><use href="#icone-mapa"></use></svg> Onde fica</h3>
            <p>
                Anápolis, Goiás.
                @* TODO: preencher com o endereço real da bancada. *@
                Endereço informado pelo WhatsApp.
            </p>
        </div>
        <div>
            <h3><svg aria-hidden="true"><use href="#icone-relogio"></use></svg> Horário</h3>
            <p>
                @* TODO: preencher com os dias e horários reais de atendimento. *@
                Atendimento com hora marcada. Confirme a disponibilidade pelo WhatsApp.
            </p>
        </div>
        <div>
            <h3>Busca e entrega</h3>
            <p>
                Buscamos e devolvemos o equipamento em Anápolis.
                Marque a opção no formulário ou combine no WhatsApp.
            </p>
        </div>
        <div>
            <h3>Pagamento</h3>
            <p>
                @* TODO: listar as formas de pagamento aceitas (Pix, dinheiro, cartão, parcelamento). *@
                As formas de pagamento são informadas junto com o orçamento.
            </p>
        </div>
    </div>
</section>

<section class="secao secao--duvidas" id="duvidas">
    <div class="secao__lateral">
        <span class="rotulo">Dúvidas</span>
        <h2 class="titulo-secao">Perguntas que chegam antes do serviço</h2>
        <p>
            Se a sua dúvida não estiver aqui, chame no WhatsApp. Respondemos no horário de atendimento.
        </p>
        <a class="botao botao--linha botao--pequeno" asp-controller="Home" asp-action="Forum">Ver todas as dúvidas</a>
    </div>

    <div class="perguntas">
        <details>
            <summary>Quanto custa o conserto?</summary>
            <p>O valor depende do diagnóstico. Você recebe um orçamento antes de qualquer serviço começar e só autoriza se concordar.</p>
        </details>
        <details>
            <summary>Quanto tempo leva?</summary>
            <p>A maioria dos serviços fica pronta entre 24 e 96 horas. Quando é necessário aguardar peças, o prazo é avisado pelo contato informado na solicitação.</p>
        </details>
        <details>
            <summary>O serviço tem garantia?</summary>
            <p>Sim. Os serviços têm 90 dias de garantia para o problema identificado no atendimento.</p>
        </details>
        <details>
            <summary>Preciso criar conta para pedir orçamento?</summary>
            <p>Não. O formulário de solicitação é aberto a qualquer visitante. A conta serve para acompanhar pedidos e preencher os dados mais rápido.</p>
        </details>
    </div>
</section>

<section class="chamada">
    <div>
        <span class="rotulo">Orçamento</span>
        <h2>Descreva o problema e receba o valor.</h2>
        <p>
            Se preferir, mande uma mensagem no WhatsApp com o modelo do equipamento e o que está acontecendo.
            Quanto mais detalhes, mais rápido fica o diagnóstico.
        </p>
    </div>
    <div class="chamada__acoes">
        <a class="botao botao--whats" href="@zap" target="_blank" rel="noopener noreferrer">
            <svg aria-hidden="true"><use href="#icone-whatsapp"></use></svg>
            Chamar no WhatsApp
        </a>
        <a class="botao botao--linha" asp-controller="ServiceRequest" asp-action="Create">Abrir solicitação</a>
        <a class="chamada__telefone" href="tel:+5562998877833">(62) 99887-7833</a>
    </div>
</section>
