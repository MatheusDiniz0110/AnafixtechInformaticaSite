@{
    ViewData["Title"] = "Sobre";
}

@section Head {
    <meta name="description" content="AnaFixTech Informática: assistência técnica especializada em Anápolis (GO). Manutenção de computadores, recuperação de dados, redes e suporte técnico, com garantia de 90 dias." />

    <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "LocalBusiness",
          "name": "AnaFixTech Informática",
          "description": "Assistência técnica especializada em manutenção de computadores, recuperação de dados, redes e suporte técnico.",
          "telephone": "+55 62 99887-7833",
          "email": "matheus.diniz.t@outlook.com",
          "address": {
            "@@type": "PostalAddress",
            "addressLocality": "Anápolis",
            "addressRegion": "GO",
            "addressCountry": "BR"
          },
          "founder": { "@@type": "Person", "name": "Matheus Diniz Tereza" }
        }
    </script>

    <style>
        /* ====================================================================
           Página "Sobre" — todos os estilos usam o prefixo .sobre- para não
           interferir no resto do site.
           ==================================================================== */
        .sobre {
            --s-card: #1e293b;
            --s-card-dark: #111827;
            --s-border: rgba(148, 163, 184, .18);
            --s-text: #e2e8f0;
            --s-muted: #94a3b8;
            --s-accent: #38bdf8;
            --s-accent-strong: #0284c7;
            --s-gold: #facc15;
            color: var(--s-text);
            line-height: 1.65;
            padding: 2rem 0 4rem;
        }

        .sobre *, .sobre *::before, .sobre *::after { box-sizing: border-box; }

        .sobre h1, .sobre h2, .sobre h3 { color: #f8fafc; line-height: 1.2; margin: 0; }
        .sobre p { margin: 0 0 1rem; }
        .sobre a { color: var(--s-accent); text-decoration: none; }
        .sobre a:hover { text-decoration: underline; }
        .sobre a:focus-visible, .sobre-btn:focus-visible { outline: 3px solid var(--s-gold); outline-offset: 3px; border-radius: 8px; }

        /* ---------- Hero ---------- */
        .sobre-hero {
            text-align: center;
            padding: 4.5rem 1.5rem 4rem;
            border-radius: 24px;
            border: 1px solid var(--s-border);
            background:
                radial-gradient(900px 340px at 50% -10%, rgba(56, 189, 248, .22), transparent 65%),
                linear-gradient(180deg, var(--s-card-dark), #0f172a);
        }

        .sobre-eyebrow {
            display: inline-block;
            padding: .3rem .95rem;
            border-radius: 999px;
            font-size: .78rem;
            font-weight: 600;
            letter-spacing: .14em;
            text-transform: uppercase;
            color: var(--s-accent);
            background: rgba(56, 189, 248, .1);
            border: 1px solid rgba(56, 189, 248, .3);
        }

        .sobre-hero h1 {
            font-size: clamp(2.1rem, 5.5vw, 3.6rem);
            font-weight: 800;
            margin: 1.1rem 0 .9rem;
        }

        .sobre-hero h1 span { color: var(--s-accent); }

        .sobre-lead {
            max-width: 680px;
            margin: 0 auto 2rem;
            font-size: 1.15rem;
            color: var(--s-muted);
        }

        .sobre-actions { display: flex; flex-wrap: wrap; gap: .85rem; justify-content: center; }

        .sobre-btn {
            display: inline-block;
            padding: .8rem 1.6rem;
            border-radius: 12px;
            font-weight: 600;
            border: 1px solid transparent;
            transition: transform .15s ease, box-shadow .15s ease, background .15s ease;
        }

        .sobre-btn:hover { transform: translateY(-2px); text-decoration: none; }

        .sobre-btn--primary {
            color: #04121f !important;
            background: linear-gradient(135deg, var(--s-accent), #7dd3fc);
            box-shadow: 0 8px 24px rgba(56, 189, 248, .25);
        }

        .sobre-btn--ghost {
            color: var(--s-text) !important;
            background: transparent;
            border-color: var(--s-border);
        }

        .sobre-btn--ghost:hover { background: rgba(148, 163, 184, .1); }

        /* ---------- Seções ---------- */
        .sobre-section { margin-top: 4.5rem; }

        .sobre-section > header { text-align: center; margin-bottom: 2rem; }

        .sobre-kicker {
            display: block;
            margin-bottom: .5rem;
            font-size: .8rem;
            font-weight: 600;
            letter-spacing: .14em;
            text-transform: uppercase;
            color: var(--s-accent);
        }

        .sobre-section h2 { font-size: clamp(1.6rem, 3.5vw, 2.2rem); }

        .sobre-sub { max-width: 640px; margin: .75rem auto 0; color: var(--s-muted); }

        .sobre-grid {
            display: grid;
            gap: 1.25rem;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        }

        .sobre-card {
            padding: 1.6rem;
            border-radius: 18px;
            background: var(--s-card);
            border: 1px solid var(--s-border);
            transition: transform .2s ease, border-color .2s ease;
        }

        .sobre-card:hover { transform: translateY(-4px); border-color: rgba(56, 189, 248, .45); }
        .sobre-card h3 { font-size: 1.1rem; margin: .85rem 0 .4rem; }
        .sobre-card p { margin: 0; color: var(--s-muted); font-size: .96rem; }

        .sobre-icon {
            display: grid;
            place-items: center;
            width: 48px;
            height: 48px;
            font-size: 1.4rem;
            border-radius: 14px;
            background: rgba(56, 189, 248, .12);
            border: 1px solid rgba(56, 189, 248, .25);
        }

        /* ---------- Quem somos ---------- */
        .sobre-about {
            display: grid;
            gap: 2rem;
            align-items: start;
            grid-template-columns: 1.4fr 1fr;
        }

        .sobre-about-text p { color: #cbd5e1; font-size: 1.04rem; }

        .sobre-facts {
            padding: 1.5rem;
            border-radius: 18px;
            background: var(--s-card);
            border: 1px solid var(--s-border);
        }

        .sobre-facts h3 { font-size: 1rem; margin-bottom: 1rem; color: var(--s-accent); }
        .sobre-facts dl { margin: 0; }
        .sobre-facts dt { font-size: .78rem; text-transform: uppercase; letter-spacing: .1em; color: var(--s-muted); }
        .sobre-facts dd { margin: 0 0 .9rem; font-weight: 600; }
        .sobre-facts dd:last-child { margin-bottom: 0; }

        /* ---------- Destaques ---------- */
        .sobre-highlight { text-align: center; }
        .sobre-highlight .sobre-icon { margin: 0 auto; }
        .sobre-number { display: block; margin-top: .9rem; font-size: 2rem; font-weight: 800; color: var(--s-gold); }
        .sobre-highlight h3 { margin-top: .2rem; }

        /* ---------- Como funciona ---------- */
        .sobre-steps { list-style: none; margin: 0; padding: 0; counter-reset: passo; display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }

        .sobre-steps li {
            position: relative;
            counter-increment: passo;
            padding: 1.5rem 1.4rem 1.4rem;
            border-radius: 18px;
            background: var(--s-card);
            border: 1px solid var(--s-border);
        }

        .sobre-steps li::before {
            content: counter(passo);
            display: grid;
            place-items: center;
            width: 36px;
            height: 36px;
            margin-bottom: .8rem;
            font-weight: 800;
            color: #04121f;
            border-radius: 50%;
            background: var(--s-accent);
        }

        .sobre-steps strong { display: block; margin-bottom: .3rem; color: #f8fafc; }
        .sobre-steps span { color: var(--s-muted); font-size: .95rem; }

        /* ---------- Sobre o site ---------- */
        .sobre-site {
            display: grid;
            gap: 1.5rem;
            padding: 2rem;
            border-radius: 22px;
            background: linear-gradient(160deg, var(--s-card), var(--s-card-dark));
            border: 1px solid var(--s-border);
            grid-template-columns: auto 1fr;
            align-items: start;
        }

        .sobre-avatar {
            display: grid;
            place-items: center;
            width: 84px;
            height: 84px;
            font-size: 1.8rem;
            font-weight: 800;
            color: #04121f;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--s-accent), var(--s-gold));
        }

        .sobre-site h3 { font-size: 1.35rem; }
        .sobre-role { margin: .15rem 0 1rem; color: var(--s-muted); }

        .sobre-chips { display: flex; flex-wrap: wrap; gap: .5rem; margin: 1rem 0 1.25rem; padding: 0; list-style: none; }

        .sobre-chip {
            padding: .3rem .8rem;
            font-size: .85rem;
            border-radius: 999px;
            color: var(--s-text);
            background: rgba(148, 163, 184, .12);
            border: 1px solid var(--s-border);
        }

        .sobre-feature-list { margin: 0 0 1.25rem; padding-left: 1.2rem; color: #cbd5e1; }
        .sobre-feature-list li { margin-bottom: .35rem; }
        .sobre-feature-list li::marker { color: var(--s-accent); }

        .sobre-links { display: flex; flex-wrap: wrap; gap: 1.25rem; }

        /* ---------- Contato ---------- */
        .sobre-contact a.sobre-card { display: block; color: var(--s-text); }
        .sobre-contact a.sobre-card:hover { text-decoration: none; }
        .sobre-contact .sobre-value { display: block; margin-top: .25rem; font-weight: 600; color: var(--s-accent); word-break: break-word; }

        /* ---------- Chamada final ---------- */
        .sobre-cta {
            margin-top: 4.5rem;
            padding: 3rem 1.5rem;
            text-align: center;
            border-radius: 24px;
            border: 1px solid rgba(56, 189, 248, .35);
            background:
                radial-gradient(700px 260px at 50% 120%, rgba(56, 189, 248, .22), transparent 70%),
                var(--s-card-dark);
        }

        .sobre-cta h2 { font-size: clamp(1.5rem, 3.5vw, 2.1rem); margin-bottom: .6rem; }
        .sobre-cta p { color: var(--s-muted); margin-bottom: 1.6rem; }

        /* ---------- Responsivo ---------- */
        @@media (max-width: 820px) {
            .sobre-about { grid-template-columns: 1fr; }
        }

        @@media (max-width: 640px) {
            .sobre { padding-top: 1rem; }
            .sobre-hero { padding: 3rem 1.1rem 2.75rem; border-radius: 18px; }
            .sobre-section, .sobre-cta { margin-top: 3.25rem; }
            .sobre-site { grid-template-columns: 1fr; padding: 1.5rem; }
        }

        @@media (prefers-reduced-motion: reduce) {
            .sobre-card, .sobre-btn { transition: none; }
            .sobre-card:hover, .sobre-btn:hover { transform: none; }
        }
    </style>
}

<div class="sobre">

    <!-- ===================== HERO ===================== -->
    <section class="sobre-hero" aria-labelledby="sobre-titulo">
        <span class="sobre-eyebrow">Sobre nós</span>
        <h1 id="sobre-titulo">AnaFixTech <span>Informática</span></h1>
        <p class="sobre-lead">
            Assistência técnica especializada em Anápolis (GO). Transformamos problemas de tecnologia
            em soluções, com rapidez e qualidade.
        </p>
        <div class="sobre-actions">
            <a class="sobre-btn sobre-btn--primary" asp-controller="Orders" asp-action="Create">Solicitar serviço →</a>
            <a class="sobre-btn sobre-btn--ghost" asp-controller="Services" asp-action="Index">Ver serviços</a>
        </div>
    </section>

    <!-- ===================== QUEM SOMOS ===================== -->
    <section class="sobre-section" aria-labelledby="quem-somos">
        <header>
            <span class="sobre-kicker">Quem somos</span>
            <h2 id="quem-somos">Tecnologia que volta a funcionar</h2>
        </header>

        <div class="sobre-about">
            <div class="sobre-about-text">
                <p>
                    A <strong>AnaFixTech Informática</strong> é uma empresa de serviços de TI com sede em
                    <strong>Anápolis, Goiás</strong>. Somos especialistas em manutenção de computadores,
                    recuperação de dados e suporte técnico, para quem precisa do equipamento funcionando
                    sem complicação.
                </p>
                <p>
                    A empresa é fundada e conduzida por <strong>Matheus Diniz Tereza</strong>, desenvolvedor
                    com experiência em programação, sistemas e automação. Esse olhar técnico aparece no
                    atendimento: diagnóstico claro, explicação em linguagem simples e acompanhamento do
                    pedido do começo ao fim.
                </p>
                <p>
                    Atendemos pessoas e pequenas empresas da região, do notebook que não liga ao
                    backup dos arquivos que não podem ser perdidos.
                </p>
            </div>

            <aside class="sobre-facts" aria-label="Resumo da empresa">
                <h3>Resumo</h3>
                <dl>
                    <dt>Empresa</dt>
                    <dd>AnaFixTech Informática</dd>
                    <dt>Segmento</dt>
                    <dd>Assistência técnica e serviços de TI</dd>
                    <dt>Sede</dt>
                    <dd>Anápolis, Goiás — Brasil</dd>
                    <dt>Responsável</dt>
                    <dd>Matheus Diniz Tereza</dd>
                    <dt>Categorias de serviço</dt>
                    <dd>Software · Hardware · Dados</dd>
                </dl>
            </aside>
        </div>
    </section>

    <!-- ===================== DESTAQUES ===================== -->
    <section class="sobre-section" aria-labelledby="compromissos">
        <header>
            <span class="sobre-kicker">Nossos compromissos</span>
            <h2 id="compromissos">O que você pode esperar</h2>
        </header>

        <div class="sobre-grid">
            <article class="sobre-card sobre-highlight">
                <div class="sobre-icon" aria-hidden="true">🛡️</div>
                <span class="sobre-number">90 dias</span>
                <h3>Garantia</h3>
                <p>Segurança de que o serviço realizado está coberto depois da entrega.</p>
            </article>
            <article class="sobre-card sobre-highlight">
                <div class="sobre-icon" aria-hidden="true">⚡</div>
                <span class="sobre-number">24 a 96 h</span>
                <h3>Prazo de entrega</h3>
                <p>Atendimento ágil, com o prazo combinado conforme a complexidade do serviço.</p>
            </article>
            <article class="sobre-card sobre-highlight">
                <div class="sobre-icon" aria-hidden="true">💬</div>
                <span class="sobre-number">WhatsApp</span>
                <h3>Contato direto</h3>
                <p>Retorno rápido pelo WhatsApp para tirar dúvidas e combinar os detalhes.</p>
            </article>
        </div>
    </section>

    <!-- ===================== SERVIÇOS ===================== -->
    <section class="sobre-section" aria-labelledby="servicos">
        <header>
            <span class="sobre-kicker">O que fazemos</span>
            <h2 id="servicos">Serviços</h2>
            <p class="sobre-sub">Uma gama completa de serviços técnicos para manter seus equipamentos funcionando perfeitamente.</p>
        </header>

        <div class="sobre-grid">
            <article class="sobre-card">
                <div class="sobre-icon" aria-hidden="true">🖥️</div>
                <h3>Manutenção de PC</h3>
                <p>Formatação, limpeza, upgrades e otimização de desempenho.</p>
            </article>
            <article class="sobre-card">
                <div class="sobre-icon" aria-hidden="true">💾</div>
                <h3>Recuperação de dados</h3>
                <p>Recuperamos arquivos perdidos de HDs, SSDs e pendrives.</p>
            </article>
            <article class="sobre-card">
                <div class="sobre-icon" aria-hidden="true">📡</div>
                <h3>Redes e Internet</h3>
                <p>Configuração de redes e roteadores e resolução de problemas de conexão.</p>
            </article>
            <article class="sobre-card">
                <div class="sobre-icon" aria-hidden="true">🔒</div>
                <h3>Backup e Segurança</h3>
                <p>Soluções de backup e proteção contra vírus.</p>
            </article>
            <article class="sobre-card">
                <div class="sobre-icon" aria-hidden="true">🧩</div>
                <h3>Instalação de Software</h3>
                <p>Instalação e configuração de sistemas e programas.</p>
            </article>
            <article class="sobre-card">
                <div class="sobre-icon" aria-hidden="true">📱</div>
                <h3>Dispositivos móveis</h3>
                <p>Suporte técnico para tablets e smartphones.</p>
            </article>
        </div>

        <div class="sobre-actions" style="margin-top: 1.75rem;">
            <a class="sobre-btn sobre-btn--ghost" asp-controller="Services" asp-action="Index">Ver o catálogo completo →</a>
        </div>
    </section>

    <!-- ===================== COMO FUNCIONA ===================== -->
    <section class="sobre-section" aria-labelledby="como-funciona">
        <header>
            <span class="sobre-kicker">Passo a passo</span>
            <h2 id="como-funciona">Como funciona</h2>
        </header>

        <ol class="sobre-steps">
            <li>
                <strong>Solicite pelo site</strong>
                <span>Preencha o formulário com os dados do equipamento e descreva o problema.</span>
            </li>
            <li>
                <strong>Escolha o horário</strong>
                <span>Selecione um horário disponível ou combinamos os detalhes pelo WhatsApp.</span>
            </li>
            <li>
                <strong>Diagnóstico e reparo</strong>
                <span>Avaliamos o equipamento, explicamos o que foi encontrado e executamos o serviço.</span>
            </li>
            <li>
                <strong>Entrega com garantia</strong>
                <span>Você recebe o equipamento pronto, com 90 dias de garantia sobre o serviço.</span>
            </li>
        </ol>
    </section>

    <!-- ===================== SOBRE O SITE ===================== -->
    <section class="sobre-section" aria-labelledby="sobre-site">
        <header>
            <span class="sobre-kicker">Por trás do site</span>
            <h2 id="sobre-site">Sobre este site</h2>
        </header>

        <div class="sobre-site">
            <div class="sobre-avatar" aria-hidden="true">MD</div>
            <div>
                <h3>Criado por Matheus Diniz Tereza</h3>
                <p class="sobre-role">Desenvolvedor e fundador da AnaFixTech Informática</p>

                <p>
                    Este site foi projetado e desenvolvido pelo próprio fundador para facilitar a vida de quem
                    precisa de suporte: encontrar o serviço certo, pedir atendimento e acompanhar tudo em um só lugar.
                    Ele está em evolução contínua, com novas funcionalidades sendo adicionadas aos poucos.
                </p>

                <ul class="sobre-feature-list">
                    <li>Catálogo de serviços com filtro por categoria</li>
                    <li>Solicitação de serviço e agendamento online</li>
                    <li>Conta de cliente para acompanhar seus pedidos</li>
                    <li>Contato rápido por WhatsApp</li>
                </ul>

                <h3 style="font-size: 1rem;">Tecnologias</h3>
                <ul class="sobre-chips" aria-label="Tecnologias utilizadas">
                    <li class="sobre-chip">C#</li>
                    <li class="sobre-chip">ASP.NET Core MVC</li>
                    <li class="sobre-chip">Entity Framework Core</li>
                    <li class="sobre-chip">SQL Server</li>
                    <li class="sobre-chip">ASP.NET Core Identity</li>
                    <li class="sobre-chip">Bootstrap</li>
                </ul>

                <div class="sobre-links">
                    <a href="https://github.com/MatheusDiniz0110" target="_blank" rel="noopener noreferrer">GitHub</a>
                    <a href="https://www.linkedin.com/in/matheus-diniz-tereza" target="_blank" rel="noopener noreferrer">LinkedIn</a>
                </div>
            </div>
        </div>
    </section>

    <!-- ===================== CONTATO ===================== -->
    <section class="sobre-section sobre-contact" aria-labelledby="contato">
        <header>
            <span class="sobre-kicker">Fale com a gente</span>
            <h2 id="contato">Contato</h2>
        </header>

        <div class="sobre-grid">
            <a class="sobre-card" href="https://wa.me/5562998877833" target="_blank" rel="noopener noreferrer">
                <div class="sobre-icon" aria-hidden="true">💬</div>
                <h3>WhatsApp</h3>
                <span class="sobre-value">(62) 99887-7833</span>
            </a>
            <a class="sobre-card" href="mailto:matheus.diniz.t@outlook.com">
                <div class="sobre-icon" aria-hidden="true">✉️</div>
                <h3>E-mail</h3>
                <span class="sobre-value">matheus.diniz.t@outlook.com</span>
            </a>
            <a class="sobre-card" href="https://www.instagram.com/anafixtech_informatica15" target="_blank" rel="noopener noreferrer">
                <div class="sobre-icon" aria-hidden="true">📸</div>
                <h3>Instagram</h3>
                <span class="sobre-value">@@anafixtech_informatica15</span>
            </a>
            <div class="sobre-card">
                <div class="sobre-icon" aria-hidden="true">📍</div>
                <h3>Localização</h3>
                <span class="sobre-value">Anápolis — GO</span>
            </div>
        </div>
    </section>

    <!-- ===================== CHAMADA FINAL ===================== -->
    <section class="sobre-cta" aria-labelledby="cta-titulo">
        <h2 id="cta-titulo">Precisa de ajuda com a sua tecnologia?</h2>
        <p>Entre em contato e resolva o seu problema ainda hoje.</p>
        <div class="sobre-actions">
            <a class="sobre-btn sobre-btn--primary" asp-controller="Orders" asp-action="Create">Solicitar serviço →</a>
            <a class="sobre-btn sobre-btn--ghost" href="https://wa.me/5562998877833?text=Ol%C3%A1!%20Gostaria%20de%20saber%20mais%20sobre%20os%20servi%C3%A7os." target="_blank" rel="noopener noreferrer">Falar no WhatsApp</a>
        </div>
    </section>

</div>
