@model AnafixtechInformaticaSite.Models.RegisterViewModel
@{
    ViewData["Title"] = "Criar conta";
    ViewData["Description"] = "Crie sua conta na AnaFixTech Informática para acompanhar pedidos de serviço e preencher os dados mais rápido.";
}

<div class="acesso">
    <div class="acesso__caixa acesso__caixa--largo">
        <span class="rotulo">Área do cliente</span>
        <h1>Criar conta</h1>
        <p class="acesso__texto">
            A conta guarda seus dados para os próximos pedidos e permite acompanhar as solicitações.
            O orçamento também pode ser pedido sem cadastro.
        </p>

        <form asp-controller="Account" asp-action="Register" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Name" class="form-label">Nome completo</label>
                    <input asp-for="Name" class="form-control" autocomplete="name" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Username" class="form-label">Nome de usuário</label>
                    <input asp-for="Username" class="form-control" autocomplete="username" />
                    <span asp-validation-for="Username" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Email" class="form-label">E-mail</label>
                    <input asp-for="Email" type="email" class="form-control" autocomplete="email" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Password" class="form-label">Senha</label>
                    <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" />
                    <div class="form-text">Use pelo menos 8 caracteres.</div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <button type="submit" class="botao w-100">Criar conta</button>
                </div>
            </div>
        </form>

        <p class="acesso__rodape">
            Já tem conta? <a asp-controller="Account" asp-action="Login">Entrar</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
